KEY_MANAGEMENT_LISTEN=127.0.0.1:8091
KEY_MANAGEMENT_UPSTREAM=http://127.0.0.1:8080
KEY_MANAGEMENT_STATE=/var/lib/sub2api-key-management/state.json
# Fixed secret: openssl rand -hex 32. Never rotate or lose without migration.
KEY_MANAGEMENT_MASTER_KEY=REPLACE_WITH_64_HEXADECIMAL_CHARACTERS
# Isolated adapter for key fields missing from the official administrator API.
KEY_MANAGEMENT_KEY_HELPER=/opt/sub2api-key-management/key_store.py
KEY_MANAGEMENT_PG_DSN="host=127.0.0.1 port=5432 dbname=sub2api user=key_management_keys password=REPLACE_ME"
KEY_MANAGEMENT_REDIS_HOST=127.0.0.1
KEY_MANAGEMENT_REDIS_PORT=6379
KEY_MANAGEMENT_REDIS_USERNAME=key_management_keys
KEY_MANAGEMENT_REDIS_PASSWORD=REPLACE_ME
KEY_MANAGEMENT_REDIS_DB=0
